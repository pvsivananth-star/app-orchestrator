# Required API Keys (free tiers)
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Optional: For Microsoft Agent Framework (uses Groq API key above)
MICROSOFT_AGENT_ENDPOINT=https://api.groq.com/openai/v1

# Provider configuration
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.0-flash-exp
MAX_RETRIES=5
RETRY_DELAY=1.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=.ox2/orchestrator.log

# Set to "1" to disable response caching (useful for testing)
APP_ORCHESTRATOR_DISABLE_CACHE=0
